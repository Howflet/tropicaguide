rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function tripDoc(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function isTripMember(tripId) {
      return isSignedIn() && (
        request.auth.uid == tripDoc(tripId).ownerId ||
        request.auth.uid in tripDoc(tripId).memberIds
      );
    }

    function canEditTrip(tripId) {
      return isSignedIn() && (
        request.auth.uid == tripDoc(tripId).ownerId ||
        tripDoc(tripId).memberRoles[request.auth.uid] in ['owner', 'editor']
      );
    }

    // Users collection: private preferences and saved destinations owned by account
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwnerUser(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string;
      allow delete: if isOwnerUser(uid);
    }

    // Trips collection: readable by members, editable by owner/editors, deletable only by owner
    match /trips/{tripId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.memberIds
      );
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId ||
        resource.data.memberRoles[request.auth.uid] in ['owner', 'editor']
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }

    // Itinerary items: normalized per-item documents linked by tripId
    match /itineraryItems/{itemId} {
      allow read: if isTripMember(resource.data.tripId);
      allow create: if canEditTrip(request.resource.data.tripId);
      allow update, delete: if canEditTrip(resource.data.tripId);
    }

    // Cached activities catalog
    match /activities/{activityId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Trip checklists
    match /checklists/{checklistId} {
      allow read: if isTripMember(resource.data.tripId);
      allow create: if canEditTrip(request.resource.data.tripId);
      allow update, delete: if canEditTrip(resource.data.tripId);
    }

    // Shared packing lists
    match /packingLists/{packingListId} {
      allow read: if isTripMember(resource.data.tripId);
      allow create: if canEditTrip(request.resource.data.tripId);
      allow update, delete: if canEditTrip(resource.data.tripId);
    }
  }
}
